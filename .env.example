# Defaults work without a database, domain, account or VPS.
PORT=3000
HOST=0.0.0.0
# Optional PostgreSQL persistence (local scores.json is always available):
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/blinov_zombies
# Optional existing public URL when using your own reverse proxy:
# PUBLIC_URL=https://game.example.com
# Optional paths/settings for the share launcher:
# SSH_PORT=22
# CLOUDFLARED=/usr/local/bin/cloudflared
