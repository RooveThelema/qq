{
  "name": "blinov-zombies-2d",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Call of Duty: Zombies 2D — бункер, мем-реклама, жесткая лудка 777 и PostgreSQL бэкенд",
  "scripts": {
    "build:classic": "node scripts/build-classic.mjs",
    "db:init": "psql -U ${PGUSER:-roovethelema} -h ${PGHOST:-127.0.0.1} -p ${PGPORT:-5432} -d ${PGDATABASE:-blinov_zombies} -f db/schema.sql",
    "start": "node scripts/build-classic.mjs && node server.js"
  },
  "dependencies": {
    "pg": "^8.20.0"
  }
}
